{
  "name": "noxctl",
  "version": "0.8.0",
  "mcpName": "io.github.magnus-gille/noxctl",
  "description": "CLI and MCP server for Fortnox — invoices, bookkeeping, VAT, payroll, and automation",
  "type": "module",
  "bin": {
    "noxctl": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./embedded": {
      "types": "./dist/embedded.d.ts",
      "import": "./dist/embedded.js",
      "default": "./dist/embedded.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "setup": "node dist/cli.js init",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "verify": "npm run version:check && npm run lint && npm run format:check && npm run build && npm test",
    "check:release": "npm run verify && npm audit --omit=dev && node scripts/check-embedded-consumer.mjs && npm pack --dry-run --ignore-scripts",
    "check:api": "bash scripts/check-api-changes.sh",
    "audit:schemas": "npm run build --silent && node scripts/audit-tool-schemas.mjs",
    "prepublishOnly": "npm run check:release",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fortnox",
    "cli",
    "automation",
    "accounting",
    "invoicing",
    "bookkeeping",
    "claude"
  ],
  "author": "Magnus Gille",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Magnus-Gille/noxctl.git"
  },
  "bugs": {
    "url": "https://github.com/Magnus-Gille/noxctl/issues"
  },
  "homepage": "https://github.com/Magnus-Gille/noxctl#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist/",
    "docs/embedded.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "commander": "^15.0.0",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.ts": "prettier --write"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.3.1"
  }
}
